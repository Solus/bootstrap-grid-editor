{
  "name": "bootstrap-visualizer-extension",
  "displayName": "Bootstrap Grid Visualizer",
  "description": "Visual editor for Bootstrap grid layouts in Angular templates.",
  "version": "0.0.6",
  "private": true,
  "publisher": "BeroXL",
  "author": {
    "name": "BeroXL"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/solus/bootstrap-visualizer",
    "directory": "packages/app-extension"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./dist/host/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "bootstrapVisualizer.open",
        "title": "$(layout) Open Grid Visualizer",
        "category": "Bootstrap Grid",
        "icon": "$(layout)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "bootstrapVisualizer.open",
          "when": "editorLangId == html",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "bootstrapVisualizer.open",
          "when": "editorTextFocus && editorLangId == html",
          "group": "navigation"
        }
      ]
    }
  },
  "activationEvents": [],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build:webview": "vite build",
    "watch:webview": "vite build --watch",
    "build:host": "esbuild src/host/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/host/extension.js --sourcemap",
    "watch:host": "npm run build:host -- --watch",
    "build": "npm run build:webview && npm run build:host",
    "vsix": "npm run build && npx @vscode/vsce package --no-dependencies --out releases/"
  },
  "devDependencies": {
    "@bootstrap-visualizer/core": "*",
    "@bootstrap-visualizer/editor": "*",
    "@types/vscode": "^1.96.0",
    "esbuild": "^0.24.0",
    "vite": "^5.4.0"
  }
}
