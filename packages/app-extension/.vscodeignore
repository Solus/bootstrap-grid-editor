# Ship only the built extension (dist/) + docs (README, CHANGELOG). dist/ is
# included by default; .vscodeignore uses .gitignore semantics.
src/**
examples/**
releases/**
node_modules/**
test-integration/**
dist/test-integration/**
.vscode/**
.vscode-test/**
.vscode-test.mjs
tsconfig*.json
vite.config.ts
**/*.map
**/*.ts

# The demo gif is large; it's referenced by absolute raw-GitHub URL in the
# README, so it must not bloat the package. Keep it in the repo, out of the vsix.
media/demo.gif
